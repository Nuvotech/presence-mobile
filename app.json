{
  "expo": {
    "name": "schoolClock",
    "slug": "schoolClock",
    "version": "1.0.0",
    "scheme": "schoolclock",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "SchoolClock needs camera access to scan student ID QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SchoolClock needs photo library access to upload a student photo."
        }
      ]
    ]
  }
}
