{
  "expo": {
    "name": "schoolClock",
    "slug": "schoolClock",
    "version": "1.0.0",
    "scheme": "schoolclock",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.giresse.schoolClock"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SchoolClock needs camera access to scan student ID QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SchoolClock needs photo library access to upload a student photo."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f4399b9-4ae6-4c54-9181-3c5cbfbb06f1"
      }
    }
  }
}
